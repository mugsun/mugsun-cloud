<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-cloud-ops</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>mugsun-cloud-resource</artifactId>
	<name>mugsun-cloud-resource</name>
	<description>文件和短信服务：文件上传下载、存储配置、头像和富文本图片、短信配置和发送（从 mugsun-boot-core 里分出来的类）</description>

	<dependencies>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-cloud-common</artifactId>
		</dependency>
		<!-- 短信内部接口两端约好的字段名在这个模块里。它带的转发类在这个服务里不注册：这里有短信的本地实现 -->
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-cloud-resource-api</artifactId>
		</dependency>
		<!-- 文件存储和短信的组件，从 system 挪到了这里，版本跟着 mugsun-bom 走。track 另带着一份文件存储，存它自己的回放和 sourcemap -->
		<dependency>
			<groupId>org.dromara.x-file-storage</groupId>
			<artifactId>x-file-storage-spring</artifactId>
		</dependency>
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aliyun.oss</groupId>
			<artifactId>aliyun-sdk-oss</artifactId>
		</dependency>
		<dependency>
			<groupId>org.dromara.sms4j</groupId>
			<artifactId>sms4j-spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>mugsun-cloud-resource</finalName>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>false</skip>
					<mainClass>com.mugsun.cloud.resource.ResourceApplication</mainClass>
					<!-- 和 java -jar 一致：以仓库根目录为工作目录，读 ./config/application-local.yml -->
					<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
