{
  "source": "https://github.com/mugsun/mugsun-boot",
  "core": {
    "module": "mugsun-boot-core",
    "common": "mugsun-cloud-common",
    "system": "mugsun-cloud-service/mugsun-cloud-system",
    "skip": [
      "MugsunApplication"
    ],
    "commonPackages": [
      "common",
      "tenant",
      "datascope",
      "security",
      "config",
      "cache",
      "datasource"
    ],
    "commonClasses": [
      "auth.MugsunStpInterface",
      "auth.IpRegionService",
      "auth.IpRegionProperties",
      "auth.LoginLockService",
      "auth.lock.*",
      "log.OperationLog",
      "log.OperationLogAspect",
      "log.AutoAuditAspect",
      "log.OperLogProperties",
      "log.AuditField",
      "log.mapper.SysDataAuditMapper",
      "log.mapper.SysLoginLogMapper",
      "log.mapper.SysUsualLogMapper",
      "monitor.TraceIdFilter",
      "monitor.ActuatorAuthFilter",
      "monitor.ApiLogFilter",
      "monitor.AccessLogFilter",
      "monitor.AccessLogRetentionEnvironmentPostProcessor",
      "monitor.ErrorLogRecorder",
      "monitor.OperatorNameLookup",
      "demo.ConditionalOnNotDemo",
      "demo.DemoConstants",
      "demo.DemoReadOnlyFilter",
      "demo.DemoLimitFilter",
      "demo.DemoSqlPermissionResolver",
      "demo.DemoCapacityGate",
      "demo.DemoSchemaGuard",
      "message.MessageService",
      "websocket.RedisWsMessageSender",
      "system.file.LocalFileAccessFilter",
      "gen.AiModelService",
      "gen.GenAiDraftEnhancer",
      "gen.GenNaming",
      "gen.entity.GenTable",
      "gen.entity.GenColumn",
      "system.service.HandlerSelectService",
      "system.service.MenuService",
      "gen.RuntimeSql",
      "system.entity.SysAttach",
      "system.mapper.SysAttachMapper",
      "system.service.AttachService",
      "system.service.AvatarBinder",
      "system.service.UserAvatarWriter",
      "feedback.entity.SysFeedback",
      "feedback.mapper.SysFeedbackMapper",
      "system.service.UserSelectOptions",
      "app.AppTodoReader",
      "app.dto.AppTodoItemVO",
      "system.service.NoticeViewer",
      "system.service.NoticeTitleFinder",
      "app.AppNoticeReader",
      "app.dto.AppNoticeSummaryVO",
      "app.dto.AppNoticeItemVO",
      "app.dto.AppPageVO",
      "client.entity.SysClient",
      "client.mapper.SysClientMapper",
      "log.UsualLogService",
      "captcha.CaptchaType",
      "app.AppUserReader"
    ],
    "commonControllers": [
      "controller.PingController"
    ],
    "systemClasses": [
      "config.DataInitializer",
      "config.*SchemaRunner"
    ],
    "services": [
      {
        "target": "mugsun-cloud-ops/mugsun-cloud-log",
        "classes": [
          "log.controller.*",
          "monitor.controller.ApiLogController",
          "monitor.controller.ErrorLogController"
        ]
      },
      {
        "target": "mugsun-cloud-ops/mugsun-cloud-report",
        "classes": [
          "system.controller.SysReportController",
          "system.entity.SysReport",
          "system.mapper.SysReportMapper"
        ]
      },
      {
        "target": "mugsun-cloud-ops/mugsun-cloud-develop",
        "classes": [
          "gen.**",
          "online.**"
        ]
      },
      {
        "target": "mugsun-cloud-ops/mugsun-cloud-job",
        "classes": [
          "job.**",
          "system.controller.JobController",
          "system.controller.SysJobServerController",
          "system.service.JobServerRegistry",
          "system.entity.SysJobServer",
          "system.mapper.SysJobServerMapper",
          "monitor.LogCleanJob"
        ]
      },
      {
        "target": "mugsun-cloud-ops/mugsun-cloud-resource",
        "classes": [
          "system.file.**",
          "system.controller.FileController",
          "system.controller.SysOssController",
          "system.controller.SysSmsController",
          "system.controller.RichTextImageController",
          "auth.AvatarUploadController",
          "feedback.FeedbackAttachmentController",
          "system.service.OssService",
          "system.service.SmsService",
          "system.service.AttachFileRecorder",
          "system.service.AvatarUploadService",
          "system.service.RichTextImageService",
          "system.service.FileAccessService",
          "system.entity.SysOss",
          "system.mapper.SysOssMapper",
          "system.entity.SysSms",
          "system.mapper.SysSmsMapper",
          "system.entity.SysSmsCode",
          "system.mapper.SysSmsCodeMapper",
          "system.entity.SysAttachPart",
          "system.mapper.SysAttachPartMapper"
        ]
      },
      {
        "target": "mugsun-cloud-ops/mugsun-cloud-flow",
        "classes": [
          "system.controller.FlowController",
          "system.controller.FlowExceptionAdvice",
          "system.service.FlowService",
          "system.service.FlowGraphService",
          "system.service.MugsunFlowListener",
          "system.service.MugsunPermissionHandler",
          "app.AppTodoController",
          "app.AppTodoService",
          "app.dto.AppTodoDetailVO",
          "app.dto.AppFieldVO",
          "app.dto.AppHandleDTO"
        ]
      },
      {
        "target": "mugsun-cloud-service/mugsun-cloud-desk",
        "classes": [
          "system.controller.SysNoticeController",
          "system.service.NoticeReadService",
          "system.entity.SysNotice",
          "system.entity.SysNoticeRead",
          "system.entity.SysNoticeScope",
          "system.mapper.SysNoticeMapper",
          "system.mapper.SysNoticeReadMapper",
          "system.mapper.SysNoticeScopeMapper",
          "workbench.**",
          "app.AppNoticeController",
          "app.AppNoticeService",
          "app.dto.AppNoticeDetailVO"
        ]
      },
      {
        "target": "mugsun-cloud-auth",
        "classes": [
          "auth.**",
          "captcha.**",
          "oauth.**",
          "social.**",
          "app.AppAuthController",
          "app.AppCaptchaController",
          "app.AppSliderCaptchaService",
          "app.dto.AppLoginDTO",
          "app.dto.AppSlider*",
          "app.dto.AppTicketVO",
          "system.service.SocialService",
          "system.entity.SysUserOauth",
          "system.mapper.SysUserOauthMapper",
          "log.LoginLogService",
          "client.ClientService"
        ]
      }
    ],
    "resources": [
      { "match": "application.yml", "to": "common", "as": "mugsun-boot-defaults.yml" },
      { "match": "application-*.yml", "to": "common" },
      { "match": "logback-spring.xml", "to": "common" },
      { "match": "i18n/*", "to": "common" },
      { "match": "META-INF/spring.factories", "to": "split" },
      { "match": "generator/*", "to": "mugsun-cloud-ops/mugsun-cloud-develop" },
      { "match": "flow/*.json", "to": "mugsun-cloud-ops/mugsun-cloud-flow" },
      { "match": "captcha/*", "to": "mugsun-cloud-auth" },
      { "match": "*", "to": "system" }
    ]
  },
  "extras": [
    { "module": "mugsun-boot-core", "classes": ["common.web.IpCidr"], "to": "mugsun-cloud-gateway" },
    { "module": "mugsun-boot-core", "classes": ["system.file.FileStorageTikaConfig"], "to": "mugsun-cloud-service/mugsun-cloud-track" },
    {
      "module": "mugsun-boot-ai",
      "classes": ["ai.entity.AiSecret", "ai.mapper.AiSecretMapper", "ai.support.AiDateTimeDeserializer"],
      "to": "mugsun-cloud-service/mugsun-cloud-system"
    },
    {
      "module": "mugsun-boot-core",
      "classes": ["mail.MailService", "mail.entity.SysMailTemplate", "mail.mapper.SysMailTemplateMapper"],
      "to": "mugsun-cloud-auth"
    },
    {
      "module": "mugsun-boot-core",
      "classes": ["oauth.OAuthService", "oauth.OAuth2Exception", "oauth.entity.SysOauthClient", "oauth.mapper.SysOauthClientMapper"],
      "to": "mugsun-cloud-service/mugsun-cloud-system"
    }
  ],
  "modules": [
    { "module": "mugsun-boot-gis", "target": "mugsun-cloud-service/mugsun-cloud-gis" },
    { "module": "mugsun-boot-track", "target": "mugsun-cloud-service/mugsun-cloud-track" },
    { "module": "mugsun-boot-ai", "target": "mugsun-cloud-service/mugsun-cloud-ai" }
  ],
  "files": [
    {
      "to": "deploy/docker/boot",
      "paths": [
        "scripts/gen-keys.sh",
        "scripts/init-db.sql",
        "docker/postgres/00-init-db.sh",
        "docker/full/init-pw-check.py",
        "docker/full/smoke.py",
        "docker/full/smoke-requirements.txt"
      ]
    }
  ]
}
