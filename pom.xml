<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot 版本跟 mugsun-boot / mugsun-core 保持一致，升级时三个仓库一起升 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.3</version>
		<relativePath/>
	</parent>

	<groupId>com.mugsun</groupId>
	<artifactId>mugsun-cloud</artifactId>
	<version>0.2.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>mugsun-cloud</name>
	<description>Mugsun 微服务版父工程（网关 + 公共层 + 各业务服务 + 监控中心）</description>
	<url>https://github.com/mugsun/mugsun-cloud</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<modules>
		<module>mugsun-cloud-config</module>
		<module>mugsun-cloud-common</module>
		<module>mugsun-cloud-service-api</module>
		<module>mugsun-cloud-ops-api</module>
		<module>mugsun-cloud-gateway</module>
		<module>mugsun-cloud-auth</module>
		<module>mugsun-cloud-service</module>
		<module>mugsun-cloud-ops</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- mugsun-core 用 Maven Central 上的发布版，版本和 mugsun-boot 的父 pom 一致；从 0.3.0 起基于 Spring Boot 4（0.2.x 是 Spring Boot 3.5） -->
		<mugsun.version>0.3.0</mugsun.version>
		<!-- Spring AI 只有 ai 服务用，版本和 mugsun-boot 的父 pom 一致；能进来的包见下面 enforcer 规则的 includes -->
		<spring-ai.version>2.0.3</spring-ai.version>
		<!-- Spring Cloud 2025.1.x 对应 Spring Boot 4.0.x 和 4.1.x（2026.0.x 只认 Spring Boot 4.2.x，启动时会校验）；
		     Spring Cloud Alibaba 2025.1.0.0 的 Nacos 组件自带 Nacos 客户端 3.1.1 -->
		<spring-cloud.version>2025.1.5</spring-cloud.version>
		<spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
		<!-- 监控中心用的 Spring Boot Admin，4.1.x 对应 Spring Boot 4.1.x -->
		<spring-boot-admin.version>4.1.5</spring-boot-admin.version>
		<!-- 以下版本号与 mugsun-boot 的父 pom 一致 -->
		<kingbase.jdbc.version>9.0.1.jre7</kingbase.jdbc.version>
		<dameng.jdbc.version>8.1.3.62</dameng.jdbc.version>
		<bucket4j.version>8.21.0</bucket4j.version>
		<resilience4j.version>2.2.0</resilience4j.version>
		<jsoup.version>1.23.2</jsoup.version>
		<jts.version>1.20.0</jts.version>
		<geographiclib.version>2.1</geographiclib.version>
		<!-- 单体版里 hutool-http 和 hutool-json 是短信组件 sms4j 间接带进来的，版本跟着 sms4j 走。track 和 system 不带 sms4j，在各自的 pom 里单独引入，
		     这里写的是单体版实际打进包里的版本。不放进下面的 dependencyManagement：那样会把文件和短信服务（它带着 sms4j）
		     的版本也锁在这个号上，以后 mugsun-bom 升级 sms4j 时它就跟单体版不一致了 -->
		<hutool-http.version>5.8.28</hutool-http.version>
		<!-- 单体版的 AI 模块把 tika-core 和 tika-parsers-standard-package 定在这个版本（见 mugsun-boot-ai/pom.xml），
		     打进单体版包里的就是它；文件存储组件 x-file-storage 自己带的 tika-core 是 2.4.1。ai 服务用这个版本；
		     system 和 track 没有 AI 模块，也在这里定成和单体版一样 -->
		<tika.version>3.2.2</tika.version>
		<!-- 这两个库在单体版包里的版本也是 AI 模块的 tika 带来的，这里写的是单体版包里实际的版本。改 tika.version 时对照单体版的包一起改 -->
		<commons-io.version>2.20.0</commons-io.version>
		<commons-collections4.version>4.5.0</commons-collections4.version>
		<!-- 这三个库在 ai 服务里只有 tika 带着，按 tika 自己的依赖会是别的版本；单体版里别的组件先带了下面这些版本
		     （commons-compress 来自文件存储用的 minio，commons-csv 来自导入导出用的 fastexcel，asm 来自测试用的 json-smart），
		     打进包里的是它们，tika 在单体版里就是和这些版本一起跑的。
		     只在 ai 服务的 pom 里用，不放进下面的 dependencyManagement，理由和上面的 hutool-http 相同 -->
		<asm.version>9.11.1</asm.version>
		<commons-compress.version>1.27.1</commons-compress.version>
		<commons-csv.version>1.11.0</commons-csv.version>
		<!-- Spring Cloud 的版本清单从 2025.1 起把 okhttp（4.12.1）和 bouncycastle（1.85）也管了起来。单体版不带 Spring Cloud，
		     包里是下面这些版本：okhttp 是 minio 带的；bcjmail 是 AI 模块的 tika 带的，bcpkix、bcutil 是 bcjmail 带的。
		     在下面的 dependencyManagement 里直接写版本（直接写的优先于引入的版本清单），定回单体版包里的版本 -->
		<okhttp.version>4.12.0</okhttp.version>
		<bcjmail.version>1.81</bcjmail.version>
		<bcpkix.version>1.81.1</bcpkix.version>
		<!-- 任务服务里的 guava 只有 PowerJob 带着（31.1-jre）；单体版里文件存储用的 minio 先带了下面这个版本，打进包里的是它，
		     PowerJob 在单体版里就是和它一起跑的。只在任务服务的 pom 里用，不放进下面的 dependencyManagement，理由和上面的 hutool-http 相同 -->
		<guava.version>33.3.1-jre</guava.version>
		<!-- 这里的属性名不要和 spring-boot-dependencies 里已有的属性同名：同名会把 Spring Boot 管的那个库在所有模块里的版本改掉。
		     commons-logging 从 Spring Boot 4 起由 Spring Boot 管（属性 commons-logging.version），和单体版一样，这里不再写 -->
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-bom</artifactId>
				<version>${mugsun.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- 不引入 spring-cloud-alibaba-dependencies 这份版本清单：它除了管自己的组件，还会改 guava、mybatis-spring-boot-starter
			     这些库的版本。业务代码也用到这些库，版本要和单体版的包一致。用到它的哪个组件，就在这里单独写那个组件的版本 -->
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
			</dependency>
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
				<exclusions>
					<!-- 这个组件把 Druid 连接池的启动包写成了必带的依赖，只有它「让 Druid 连接池从 Nacos 的一份配置里读自己的参数」
					     那个功能用得到，那个功能没有启用。不排除的话 Druid 会进到每个服务和网关的包里；连接池用的是 HikariCP -->
					<exclusion>
						<groupId>com.alibaba</groupId>
						<artifactId>druid-spring-boot-starter</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<dependency>
				<groupId>de.codecentric</groupId>
				<artifactId>spring-boot-admin-starter-server</artifactId>
				<version>${spring-boot-admin.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-cloud-config</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-cloud-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-cloud-resource-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-cloud-flow-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.mugsun</groupId>
				<artifactId>mugsun-cloud-desk-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.bucket4j</groupId>
				<artifactId>bucket4j_jdk17-core</artifactId>
				<version>${bucket4j.version}</version>
			</dependency>
			<dependency>
				<groupId>com.bucket4j</groupId>
				<artifactId>bucket4j_jdk17-lettuce</artifactId>
				<version>${bucket4j.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-core</artifactId>
				<version>${resilience4j.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-bulkhead</artifactId>
				<version>${resilience4j.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>${jsoup.version}</version>
			</dependency>
			<dependency>
				<groupId>org.locationtech.jts</groupId>
				<artifactId>jts-core</artifactId>
				<version>${jts.version}</version>
			</dependency>
			<dependency>
				<groupId>net.sf.geographiclib</groupId>
				<artifactId>GeographicLib-Java</artifactId>
				<version>${geographiclib.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-model</artifactId>
				<version>${spring-ai.version}</version>
				<exclusions>
					<!-- 和 mugsun-boot 一样排除：这个注解包跟着 springdoc 走，不排除的话 Maven 会改用 Spring AI 声明的旧版本。
					     下面 spring-ai-client-chat 自己也声明了这个包，两处都要排除，只排一处不起作用 -->
					<exclusion>
						<groupId>io.swagger.core.v3</groupId>
						<artifactId>swagger-annotations-jakarta</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-client-chat</artifactId>
				<version>${spring-ai.version}</version>
				<exclusions>
					<exclusion>
						<groupId>io.swagger.core.v3</groupId>
						<artifactId>swagger-annotations-jakarta</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<!-- 以下几个库定成单体版包里的版本，原因见上面属性的注释；检查办法见 docs/sync-from-boot.md 的「第三方库的版本」 -->
			<dependency>
				<groupId>org.apache.tika</groupId>
				<artifactId>tika-core</artifactId>
				<version>${tika.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tika</groupId>
				<artifactId>tika-parsers-standard-package</artifactId>
				<version>${tika.version}</version>
			</dependency>
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>${commons-io.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-collections4</artifactId>
				<version>${commons-collections4.version}</version>
			</dependency>
			<dependency>
				<groupId>com.squareup.okhttp3</groupId>
				<artifactId>okhttp</artifactId>
				<version>${okhttp.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcjmail-jdk18on</artifactId>
				<version>${bcjmail.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bcpkix.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bcpkix.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- src/boot 是从 mugsun-boot 同步来的代码和资源，和本仓库自己写的 src/main 分开放；用到的模块在自己的 pom 里启用这个插件 -->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<executions>
						<execution>
							<id>add-boot-sources</id>
							<phase>generate-sources</phase>
							<goals>
								<goal>add-source</goal>
							</goals>
							<configuration>
								<sources>
									<source>src/boot/java</source>
								</sources>
							</configuration>
						</execution>
						<execution>
							<id>add-boot-resources</id>
							<phase>generate-resources</phase>
							<goals>
								<goal>add-resource</goal>
							</goals>
							<configuration>
								<resources>
									<resource>
										<directory>src/boot/resources</directory>
									</resource>
								</resources>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- 只有网关和各服务模块打可执行包，其余模块跳过 -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<!-- 与 mugsun-boot 同一条规则：Spring AI 整组默认禁用，只放行 includes 里的四个基础包（模型接口、对话客户端和它俩依赖的公共包、模板包），
			     它们不带自动装配、不开端点、不自己联网。MCP SDK、自动装配、starter 和各家模型的接入包仍然禁止（含传递依赖）。
			     放行清单跟着 mugsun-boot 的父 pom 改，这边不单独加包 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>banned-dependencies</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>org.springframework.ai</exclude>
										<exclude>io.modelcontextprotocol*</exclude>
									</excludes>
									<includes>
										<include>org.springframework.ai:spring-ai-model</include>
										<include>org.springframework.ai:spring-ai-client-chat</include>
										<include>org.springframework.ai:spring-ai-commons</include>
										<include>org.springframework.ai:spring-ai-template-st</include>
									</includes>
									<message>禁止引入 MCP SDK（io.modelcontextprotocol*）和放行清单以外的 Spring AI 包（MCP、自动装配、starter、各家模型的接入包），规则与 mugsun-boot 一致。</message>
								</bannedDependencies>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
