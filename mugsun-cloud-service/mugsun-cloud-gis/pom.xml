<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-cloud-service</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>mugsun-cloud-gis</artifactId>
	<name>mugsun-cloud-gis</name>
	<description>gis 服务：地图图层、空间查询和分析、瓦片代理等（mugsun-boot-gis 模块）</description>

	<dependencies>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-cloud-common</artifactId>
		</dependency>
		<!-- 以下与 mugsun-boot-gis 的依赖一致 -->
		<dependency>
			<groupId>org.locationtech.jts</groupId>
			<artifactId>jts-core</artifactId>
		</dependency>
		<dependency>
			<groupId>net.sf.geographiclib</groupId>
			<artifactId>GeographicLib-Java</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>mugsun-cloud-gis</finalName>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>false</skip>
					<mainClass>com.mugsun.cloud.gis.GisApplication</mainClass>
					<!-- 和 java -jar 一致：以仓库根目录为工作目录，读 ./config/application-local.yml -->
					<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
