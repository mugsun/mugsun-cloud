<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-cloud-service</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>mugsun-cloud-system</artifactId>
	<name>mugsun-cloud-system</name>
	<description>system 服务：登录、用户、角色、菜单、租户、文件、消息、流程等（mugsun-boot-core 除了公共层和分给别的服务的部分）</description>

	<dependencies>
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-cloud-common</artifactId>
		</dependency>
		<!-- 短信在文件和短信服务里。登录、双因子和短信通知还在这里，依赖它的 api 模块就能调过去 -->
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-cloud-resource-api</artifactId>
		</dependency>
		<!-- 审批流在审批流服务里，流程引擎也只在那边。手机端首页还在这里，它要显示待办，依赖审批流的 api 模块就能取到 -->
		<dependency>
			<groupId>com.mugsun</groupId>
			<artifactId>mugsun-cloud-flow-api</artifactId>
		</dependency>
		<!-- 以下与 mugsun-boot-core 的依赖一致，是公共层用不到、只有 system 用的那些 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>me.zhyd.oauth</groupId>
			<artifactId>JustAuth</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- 登录时用 hutool-http 从 User-Agent 解析浏览器和操作系统（AuthLoginService），消息通道的配置用 hutool-json
		     解析（SysNotifyChannelController）。单体版里这两个都由短信组件 sms4j 间接带入，sms4j 跟着短信去了文件和短信服务，
		     这里单独引入，版本和单体版包里的一样。排除它们自带的 hutool-core，理由和 track 的 pom 里写的一样 -->
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-http</artifactId>
			<version>${hutool-http.version}</version>
			<exclusions>
				<exclusion>
					<groupId>cn.hutool</groupId>
					<artifactId>hutool-core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-json</artifactId>
			<version>${hutool-http.version}</version>
			<exclusions>
				<exclusion>
					<groupId>cn.hutool</groupId>
					<artifactId>hutool-core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.yomahub</groupId>
			<artifactId>liteflow-spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>mugsun-cloud-system</finalName>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>false</skip>
					<mainClass>com.mugsun.cloud.system.SystemApplication</mainClass>
					<!-- 和 java -jar 一致：以仓库根目录为工作目录，读 ./config/application-local.yml -->
					<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
