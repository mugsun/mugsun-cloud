<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mugsun</groupId>
		<artifactId>mugsun-cloud</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>mugsun-cloud-config</artifactId>
	<name>mugsun-cloud-config</name>
	<description>配置中心：带进 Nacos Config 组件（启动时从 Nacos 读配置项），另有一个读单份配置并跟着改动刷新的小工具（路由、灰度规则用）。网关和各服务共用，不带网页栈（网关是 WebFlux，服务是 Servlet，两边都能依赖）。两边都要有的日志打码也放在这里：日志里的 Nacos 访问令牌等凭证写出去之前换成星号</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<!-- 读配置用的是服务注册的那套 Nacos 地址和账号，Nacos 的客户端也由它带进来；网关和公共层本来就都依赖它 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
		</dependency>
		<!-- 配置中心用的标准组件：启动时从 Nacos 读配置项，运行中跟着改动刷新。读哪几份写在网关和各服务自己的 application.yml 里 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<!-- Nacos 的客户端自己写的日志文件默认在用户主目录下（~/logs/nacos）。测试要读它，让它写在 target 下面 -->
						<JM.LOG.PATH>${project.build.directory}/nacos-logs</JM.LOG.PATH>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
